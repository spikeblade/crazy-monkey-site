# MercadoPago
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=   # MP Dashboard → Developers → Webhooks → Clave secreta

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # Supabase Dashboard → Settings → API → service_role

# Sitio
SITE_URL=http://localhost:8888   # En producción: https://crazymonkeyshirts.com

# Admin
ADMIN_PASSWORD=...
ADMIN_EMAIL=tu@email.com

# Resend
RESEND_API_KEY=re_...

# Analytics (opcional) — sin estas variables el sitio no carga tracking ni pide cookies.
# Deben configurarse como variables de entorno de BUILD en Netlify (Astro las incrusta en el HTML estático).
PUBLIC_GA_MEASUREMENT_ID=   # Google Analytics 4 — formato G-XXXXXXXXXX
PUBLIC_META_PIXEL_ID=       # Meta Pixel — ID numérico
